# Interactive Brokers MCP server credentials.
# Copy this file to `.env` (gitignored) and fill in the real values, OR
# export these in your shell rc / direnv `.envrc`.
#
# Server: code-rabi/interactive-brokers-mcp (community, unaffiliated with IBKR).
# Bundles its own IB Gateway — does NOT use your TWS desktop, so the two won't
# fight each other.

# ---- Required for headless auth (no browser popup) ----
IB_USERNAME=your_ib_username
IB_PASSWORD_AUTH=your_ib_password
# Note: IBKR will still prompt 2FA on your phone the first time. Approve it.

# ---- Safety defaults (override only when you mean it) ----
# Paper trading account vs live. Default true. Flip to false ONLY when the user
# has signed off on tutorial output, paper-trade reconciliation, and kill-switch.
IB_PAPER_TRADING=true

# Read-only mode disables `place_order`. Default true. Flip to false to allow
# Iris to place orders (still gated by `EXECUTE: confirmed` token in her brief).
IB_READ_ONLY_MODE=true

# ---- Optional ----
# Flex Web Service token — only needed if Iris is asked to pull statements,
# trade confirmations, or historical Flex queries.
# Get from IB Account Management → Settings → Reporting → Flex Web Service.
IB_FLEX_TOKEN=
